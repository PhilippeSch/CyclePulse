    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cycle Pulse liest deinen Sitzungsverlauf und dein Körpergewicht aus Health, um Statistiken zu zeigen und Kalorien zu schätzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cycle Pulse reads your session history and body weight from Health to show statistics and estimate calories burned."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cycle Pulse lukee istuntohistoriasi ja painosi Terveydestä näyttääkseen tilastoja ja arvioidakseen kalorit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cycle Pulse läser din passhistorik och din kroppsvikt från Hälsa för att visa statistik och beräkna kalorier."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cycle Pulse kann Notizen zu Sitzungen aktualisieren, die in Health gespeichert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cycle Pulse can update session notes stored in Health."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cycle Pulse voi päivittää Terveyteen tallennettujen istuntojen muistiinpanoja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cycle Pulse kan uppdatera anteckningar om pass som sparats i Hälsa."
